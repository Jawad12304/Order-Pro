# ==========================================
# ORDER-PRO — HOSTINGER MYSQL PRODUCTION ENVIRONMENT
# Copy this file to .env.production or enter these in Hostinger Environment Variables
# ==========================================

NODE_ENV="production"
PORT=3001

# --- Hostinger MySQL Database ---
# Replace with your Hostinger MySQL database credentials created in hPanel
# Format: mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME
DATABASE_URL="mysql://u123456789_orderpro:YourStrongPassword@localhost:3306/u123456789_orderpro"

# --- Redis Cache ---
REDIS_URL="redis://localhost:6379"

# --- Domain & URL Configuration ---
# Replace with your actual domain name hosted on Hostinger
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NEXT_PUBLIC_API_URL="https://yourdomain.com/api"

# --- Authentication Secrets ---
JWT_ACCESS_SECRET="generate-a-secure-64-character-random-string-here"
JWT_REFRESH_SECRET="generate-a-different-secure-64-character-random-string-here"
MASTER_PASSWORD="YourSecureMasterPassword123!"
BCRYPT_SALT_ROUNDS=12
SUPABASE_JWT_SECRET="your-jwt-secret-or-custom-secret"

# --- Optional Third-Party Services ---
# Stripe Payment (Optional)
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."

# Cloudinary / Image Storage (Optional)
# CLOUDINARY_URL="cloudinary://..."

# Resend Email (Optional)
# RESEND_API_KEY="re_..."
