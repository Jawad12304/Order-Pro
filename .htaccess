# ==========================================
# Order-Pro — Hostinger LiteSpeed / Apache Reverse Proxy
# ==========================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Pass Authorization Headers
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Forward WebSocket requests (Socket.io)
  RewriteCond %{HTTP:Upgrade} websocket [NC]
  RewriteCond %{HTTP:Connection} upgrade [NC]
  RewriteRule ^socket.io/(.*) ws://127.0.0.1:3001/socket.io/$1 [P,L]

  # Forward API requests to Express API on port 3001
  RewriteRule ^api/(.*) http://127.0.0.1:3001/api/$1 [P,L]

  # Forward all other requests to Next.js Web on port 3000
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*) http://127.0.0.1:3000/$1 [P,L]
</IfModule>
