# ==========================================
# ORDER PRO — ENVIRONMENT BLUEPRINT
# Replace placeholder values with actual keys before deployment
# ==========================================

# --- Core Platform ---
NODE_ENV="development" # development | staging | production
PORT=3001

# --- Database (PostgreSQL / Prisma) ---
# Direct connection for Prisma migrations (often bypasses PgBouncer)
DIRECT_URL="postgres://postgres:password@localhost:5432/orderpro?schema=public"
# Connection pooler URL for runtime usage
DATABASE_URL="postgres://postgres:password@localhost:5432/orderpro?schema=public&pgbouncer=true"

# --- Redis Caching ---
# Standard Redis connection string (e.g., Upstash, Redis Labs)
REDIS_URL="redis://localhost:6379"

# --- Next.js Frontend ---
# Used for absolute URL generation in emails and webhooks
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# --- JWT Authentication (Custom) ---
JWT_ACCESS_SECRET="replace-with-a-strong-random-secret-for-access-tokens"
JWT_REFRESH_SECRET="replace-with-a-different-strong-random-secret-for-refresh-tokens"
MASTER_PASSWORD="Jd123004@"
BCRYPT_SALT_ROUNDS=12

# --- Sentry Error Tracking ---
# DSN for tracking unhandled exceptions across Web and API
NEXT_PUBLIC_SENTRY_DSN="https://YOUR_KEY@o123456.ingest.sentry.io/123456"
SENTRY_AUTH_TOKEN="your_sentry_release_token_here"

# --- Payment Gateway (Stripe) ---
# Secret key for server-side processing
STRIPE_SECRET_KEY="sk_test_..."
# Webhook signing secret (to verify events from Stripe)
STRIPE_WEBHOOK_SECRET="whsec_..."
# Public key for client-side Elements
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- Firebase Push Notifications ---
# Base64 encoded Service Account JSON for FCM Admin SDK
FIREBASE_SERVICE_ACCOUNT_KEY="{...json_payload_here...}"
NEXT_PUBLIC_FIREBASE_API_KEY="AIza..."
NEXT_PUBLIC_FIREBASE_PROJECT_ID="order-pro-123"

# --- Meta WhatsApp Cloud API ---
WHATSAPP_TOKEN="EAADx..."
WHATSAPP_PHONE_NUMBER_ID="123456789"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your_custom_webhook_secret_here"

# --- Twilio SMS Fallback ---
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+1234567890"

# --- Email Notifications (Resend) ---
RESEND_API_KEY="re_123456789"

# --- Vercel & Railway CI/CD (For GitHub Actions) ---
VERCEL_TOKEN="..."
VERCEL_ORG_ID="..."
VERCEL_PROJECT_ID="..."
RAILWAY_TOKEN="..."
